---
import PostCard from './PostCard.astro';
import type { BlogPost } from '@utils/posts';

interface Props {
  posts: BlogPost[];
  /** "home" = susun atur istimewa (artikel utama besar), "archive" = senarai biasa */
  variant?: 'home' | 'archive';
}

const { posts, variant = 'archive' } = Astro.props;
---

<div class={`posts posts--${variant}`}>
  {posts.map((post, index) => <PostCard post={post} eager={index === 0} />)}
</div>
