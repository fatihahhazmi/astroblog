---
import { formatDate, getCategoryUrl, getPostImage, getPostUrl, type BlogPost } from '@utils/posts';

interface Props {
  post: BlogPost;
  /** Gambar dimuat segera untuk kad pertama (lebih laju) */
  eager?: boolean;
}

const { post, eager = false } = Astro.props;
const { title, description, excerpt, pubDate, category, coverAlt } = post.data;
const url = getPostUrl(post);
const image = getPostImage(post);
---

<article class="post-card">
  {image && (
    <a class="post-card__media" href={url} tabindex="-1" aria-hidden="true">
      <img
        src={image}
        alt={coverAlt || title}
        width="800"
        height="500"
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
      />
    </a>
  )}
  <div class="post-card__body">
    <p class="post-card__meta">
      <a class="cat" href={getCategoryUrl(category)}>{category}</a>
      <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
    </p>
    <h2 class="post-card__title"><a href={url}>{title}</a></h2>
    <p class="post-card__excerpt">{excerpt ?? description}</p>
  </div>
</article>
